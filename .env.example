# Copy to .env (gitignored) and fill in.
# When both are set, the app uses Supabase. When either is missing, it falls
# back to the localStorage mock — useful for local UI work without a backend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...your-anon-key...
